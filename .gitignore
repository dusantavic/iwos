# ──────────────────────────────────────────────────────────────────────────────
# Secrets — never commit. Use the *.example files as templates.
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# Exception: Frontend/.env holds only local dev URLs (localhost ports), no secrets.
# It is committed so `npm run dev` works straight after clone.
!Frontend/.env

# Local dev overrides hold connection strings / JWT keys / SMTP passwords.
# Copy appsettings.Development.example.json -> appsettings.Development.json.
**/appsettings.Development.json
**/appsettings.Production.json
**/secrets.json

# ──────────────────────────────────────────────────────────────────────────────
# Runtime data — user uploads are per-deployment, not source
# ──────────────────────────────────────────────────────────────────────────────
Backend/wwwroot/uploads/*
!Backend/wwwroot/uploads/profiles/
!Backend/wwwroot/uploads/thumbnails/
Backend/wwwroot/uploads/profiles/*
Backend/wwwroot/uploads/thumbnails/*
!Backend/wwwroot/uploads/profiles/.gitkeep
!Backend/wwwroot/uploads/thumbnails/.gitkeep

