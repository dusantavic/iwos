{
  "//": "Copy to appsettings.Development.json and fill in local values. That file is gitignored.",
  "ConnectionStrings": {
    "Db": "Server=localhost;Port=5432;Database=iwos;User Id=postgres;Password=__YOUR_LOCAL_PASSWORD__;SearchPath=hrs;SSL Mode=Disable;Trust Server Certificate=true;"
  },
  "Application": {
    "JwtSettings": {
      "Issuer": "https://localhost:7192",
      "Audience": "https://localhost:7192",
      "AdminAudience": "https://localhost:7192/admin",
      "//JwtSecretKey": "Any string of 32+ chars. Generate: openssl rand -base64 48",
      "JwtSecretKey": "__LOCAL_DEV_KEY_AT_LEAST_32_CHARACTERS__",
      "AdminAccessTokenExpirationInMinutes": 30
    }
  },
  "EmailNotificationSettings": {
    "//": "Optional locally — leave empty to disable outgoing mail.",
    "EmailNotificationAddress": "",
    "EmailNotificationAddressPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
