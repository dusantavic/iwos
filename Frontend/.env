# Local-dev only (npm run dev). Production values are baked at Docker build time
# via the VITE_API_BASE_URL build arg in Frontend/Dockerfile.
VITE_API_BASE_URL=http://localhost:5097/api/v1
# Same-origin in production (served by nginx via /uploads proxy). Override here
# only because the dev server runs on :5173 while the API serves uploads on :5097.
VITE_ASSETS_BASE_URL=http://localhost:5097
