# Copy to .env and fill in real values:
#   cp .env.example .env
#   docker compose --env-file .env -f docker-compose.prod.yml up -d --build
#
# .env is gitignored. Never commit real values to this file.

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=iwos
POSTGRES_USER=iwos_app
# Generate: openssl rand -base64 24 | tr -dc A-Za-z0-9 | cut -c1-24
POSTGRES_PASSWORD=__CHANGE_ME__

# ── JWT signing key ──────────────────────────────────────────────────────────
# Must be at least 32 bytes; 64 recommended.
# Generate: openssl rand -base64 64
APPLICATION__JWTSETTINGS__JWTSECRETKEY=__CHANGE_ME__

# ── Email notifications ──────────────────────────────────────────────────────
# Gmail App Password (16 chars, no spaces): https://myaccount.google.com/apppasswords
EMAILNOTIFICATIONSETTINGS__EMAILNOTIFICATIONADDRESS=notifications@example.com
EMAILNOTIFICATIONSETTINGS__EMAILNOTIFICATIONADDRESSPASSWORD=__CHANGE_ME__

# ── Public hostname (used by Caddy for TLS cert issuance) ────────────────────
PUBLIC_HOSTNAME=example.com
